{
  "name": "zillion",
  "version": "1.0.0",
  "description": "Zillion is a private chat powered by an advanced mix of Nostr and e2e encryption.",
  "keywords": [
    "zillion",
    "chat",
    "nostr",
    "e2e"
  ],
  "homepage": "https://github.com/44Billion/zillion#readme",
  "bugs": {
    "url": "https://github.com/44Billion/zillion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/44Billion/zillion.git"
  },
  "license": "MIT",
  "author": "arthurfranca",
  "type": "module",
  "scripts": {
    "// link:nappup": "Register the nappup checkout with the current Node/npm installation and restore the local link.",
    "link:nappup": "(cd ../../nappup && npm link) && npm link nappup --no-save --package-lock=false",
    "// start": "Start/reuse the local launcher, watch files, and publish drafts after a 2s debounce.",
    "start": "node bin/dev.js",
    "// start:adb": "Run the draft watcher with Android port forwarding and Chrome/Edge console logs.",
    "start:adb": "node bin/dev.js --adb",
    "// build": "Build production files in dist/zillion/.",
    "build": "node bin/build.js",
    "// upload": "Build and publish to the main channel.",
    "upload": "node bin/upload.js main",
    "// upload:draft": "Build and publish once to the draft channel.",
    "upload:draft": "node bin/upload.js draft",
    "// test:browser": "Run Chrome tests against the real local runtime in disposable profiles.",
    "test:browser": "node --test --test-concurrency=1 'tests/browser/*.browser.js'",
    "// serve": "Preview dist/zillion/ on port 4000 without injected runtime APIs.",
    "serve": "python3 server.py",
    "// test": "Run the Node test suite.",
    "test": "node --test 'tests/**/*.test.js'",
    "// test:only": "Run only Node tests marked with only.",
    "test:only": "node --test --test-only 'tests/**/*.test.js'",
    "// lint": "Check code style with ESLint.",
    "lint": "eslint ."
  },
  "imports": {
    "#f": "thenameisf",
    "#f/*": "thenameisf/*",
    "#bin/*": "./bin/*",
    "#lib/*": "./lib/*",
    "#*": [
      "./src/*"
    ],
    "#assets/*": "./src/assets/*",
    "#config/*": "./src/config/*",
    "#helpers/*": "./src/helpers/*",
    "#services/*": "./src/services/*",
    "#hooks/*": "./src/components/hooks/*",
    "#shared/*": "./src/components/shared/*",
    "#views/*": "./src/components/views/*"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "libp2r2p": "^0.10.12",
    "thenameisf": "^1.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "eslint-plugin-html": "^8.1.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "jsonc-parser": "^3.3.1",
    "neostandard": "^0.12.1"
  }
}
